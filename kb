#!/usr/bin/env bash
# kb — CLI unifiée pour l'index du vault seo-kb
#
# Usage:
#   ./kb rebuild              -> backfill audit + concepts.json + embeddings (incremental)
#   ./kb rebuild --full       -> embeddings rebuild from scratch
#   ./kb search "ma requête" [--k 8] [--type concept] [--tag doctrine-tim]
#   ./kb audit-frontmatter    -> liste les raw/ sans frontmatter
#   ./kb backfill             -> backfill frontmatter raw/ (dry-run par défaut, --apply pour écrire)
#   ./kb concepts             -> rebuild concepts.json uniquement

set -euo pipefail

KB_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$KB_ROOT/.venv"
SCRIPTS="$KB_ROOT/.claude/scripts"

if [[ ! -d "$VENV" ]]; then
  echo "[kb] venv absent — création..."
  python3 -m venv "$VENV"
  "$VENV/bin/pip" install -q --upgrade pip
  "$VENV/bin/pip" install -q -r "$SCRIPTS/requirements.txt"
fi

PY="$VENV/bin/python"

cmd="${1:-help}"
shift || true

case "$cmd" in
  rebuild)
    echo "[kb] 1/3 audit frontmatter raw/..."
    "$PY" "$SCRIPTS/backfill_frontmatter.py" --audit
    echo
    echo "[kb] 2/3 concepts.json..."
    "$PY" "$SCRIPTS/build_concepts_index.py"
    echo
    echo "[kb] 3/3 vector index..."
    "$PY" "$SCRIPTS/embed_vault.py" "$@"
    ;;
  search)
    "$PY" "$SCRIPTS/search.py" "$@"
    ;;
  audit-frontmatter|audit)
    "$PY" "$SCRIPTS/backfill_frontmatter.py" --audit
    ;;
  backfill)
    "$PY" "$SCRIPTS/backfill_frontmatter.py" "$@"
    ;;
  concepts)
    "$PY" "$SCRIPTS/build_concepts_index.py"
    ;;
  embed)
    "$PY" "$SCRIPTS/embed_vault.py" "$@"
    ;;
  help|--help|-h|"")
    sed -n '2,12p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    ;;
  *)
    echo "[kb] commande inconnue: $cmd" >&2
    echo "lance: ./kb help" >&2
    exit 1
    ;;
esac
