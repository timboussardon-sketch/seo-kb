<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.timboussardon.ingest-backlog</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/timothee/.local/bin/seo-kb/run-ingest-backlog.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/timothee/Code/seo-kb</string>

    <key>StandardOutPath</key>
    <string>/Users/timothee/Code/seo-kb/.claude/logs/ingest-backlog.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/timothee/Code/seo-kb/.claude/logs/ingest-backlog.stderr.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/timothee</string>
    </dict>
</dict>
</plist>
